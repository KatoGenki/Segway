# Auto detect text files and perform LF normalization
* text=auto
# Keep Unity YAML assets consistently text-merged.
*.unity text eol=crlf
*.prefab text eol=crlf
*.asset text eol=crlf
*.meta text eol=crlf
# Unity baked lighting data is binary and must retain its original bytes.
LightingData.asset binary
# Store binary models, textures, audio and video anywhere under Assets in LFS.
# Match extensions regardless of letter case. Git attributes cannot match by size.
/Assets/**/*.[fF][bB][xX] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[bB][lL][eE][nN][dD] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[oO][bB][jJ] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[gG][lL][tT][fF] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[gG][lL][bB] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[dD][aA][eE] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[sS][tT][lL] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[pP][sS][dD] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[pP][sS][bB] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[tT][gG][aA] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[tT][iI][fF] filter=lfs diff=lfs merge=lfs -text
/Assets/**/*.[tT][iI][fF][fF] filter=lfs diff=lfs merge=lfs -text
