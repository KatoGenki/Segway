# Auto detect text files and perform LF normalization
* text=auto
# Keep Unity YAML assets consistently text-merged.
*.unity text eol=crlf
*.prefab text eol=crlf
*.asset text eol=crlf
*.meta text eol=crlf
# Treat common large binary assets as binary.
*.psd binary
Assets/Models/Animation/無題.blend filter=lfs diff=lfs merge=lfs -text
Assets/Models/Businessman_SegwayAnimation.fbx filter=lfs diff=lfs merge=lfs -text
Assets/Models/Businessman_SegwayBackwardAnimation.fbx filter=lfs diff=lfs merge=lfs -text
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.mov binary
